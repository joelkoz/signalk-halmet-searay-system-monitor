# Device settings for this build. Copy this file to .env (gitignored) and fill
# in your values. scripts/load_dotenv.py reads .env automatically for every
# build and upload, from the command line or the PlatformIO IDE; there is no
# need to source it into your shell. Variables already exported in your shell
# override the file.

# Device hostname (bare, no domain). Used as the WiFi/mDNS hostname, the
# ArduinoOTA hostname, and the default OTA upload target (<hostname>.local).
DEVICE_HOSTNAME=sk-monitor

# WiFi network the device joins. WIFI_PASSWORD is also the password of the
# device's fallback configuration access point.
WIFI_SSID=your-ssid
WIFI_PASSWORD=your-wifi-password

# Signal K server.
SIGNALK_HOST=signalk-server.local
SIGNALK_PORT=3000

# Password for over-the-air updates. Compiled into the firmware and used by
# `pio run -e halmet_ota -t upload`, so the two always match.
OTA_PASSWORD=choose-an-ota-password

# Optional: OTA upload target, if <DEVICE_HOSTNAME>.local does not resolve on
# your network (an IP address or another hostname).
# OTA_UPLOAD_HOST=192.168.1.50

# Ship time zone. The name is for logging; POSIX is what the C runtime uses.
SHIP_TZ_NAME="US Eastern"
SHIP_TZ_POSIX="EST5EDT,M3.2.0/2,M11.1.0/2"
